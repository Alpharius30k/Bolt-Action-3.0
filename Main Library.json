        "typeName": "Abilities",
        "characteristics": [{"name": "Description", "$text": "Each model can fire at different targets.", "typeId": "855b-a61a-569c-a804"}]
      },
      {
        "name": "Inspiring Presence",
        "id": "862d-dcd7-6fb8-d2f4",
        "hidden": false,
        "typeId": "2133-190a-94b8-c4f5",
        "typeName": "Abilities",
        "characteristics": [
          {
            "name": "Description",
            "$text": "Upon receiving his order dice (except for Down), a chaplain may select one friendly unit within 6″ and roll a D6 the chaplain may remove 1 pin from the selected unit.",
            "typeId": "855b-a61a-569c-a804"
          }
        ]
      },
      {
        "name": "Self-Defence",
        "id": "e8b4-73d0-f785-0ac6",
        "hidden": false,
        "typeId": "2133-190a-94b8-c4f5",
        "typeName": "Abilities",
        "characteristics": [
          {
            "name": "Description",
            "$text": " Cannot fire weapons. Cannot initiate close quarters combat. Do not count towards victory conditions or KPs.",
            "typeId": "855b-a61a-569c-a804"
          }
        ]
      }
    ],
    "sharedRules": [
      {"name": "Assault", "id": "6f4d-5644-3c2e-e1b2", "description": "Ignore -1 **to hit** due to **movement**", "hidden": false},
      {"name": "Team", "id": "7836-2556-8c6d-07c4", "description": "If this **weapons** unit goes down to 1 **model** it has **-1 to hit**", "hidden": false},
      {"name": "Fixed", "id": "7a52-6b20-fdaa-42c4", "description": "Can only fire in the **Front Arc** of the model.", "hidden": false},
      {
        "name": "Fanatic",
        "id": "f32b-1e88-ba1d-3efd",
        "description": "If there are atleast 2 **models** in a unit with this they ignore **pin modifiers**  when making **moral rolls** and this unit can not be **destroyed** due to having more **pin markers** then its **moral** if it has 2 models. In **close combat** if a unit with this and atleast 2 models **looses** it actually counts as a **draw** and another **close combat starts**.",
        "hidden": false
      },
      {"name": "Tow", "id": "5121-e676-4f12-eb50", "description": "Vehicle may tow Artilley Guns and the Crew may ride on board", "hidden": false},
      {"name": "Transport", "id": "e0e2-d039-c73f-5568", "description": " Vehicle may carry Infantry units", "hidden": false},
      {"name": "360° Arc", "id": "5cb5-d617-6c0f-f9e4", "description": "Can Fire all around this model", "hidden": false},
      {"name": "Flak", "id": "9c73-bd8d-0be9-fd6f", "description": "This **weapon** can attack **aircraft** during an **Airstrike**", "hidden": false},
      {"name": "Can not Run", "id": "c841-9196-e994-7da2", "description": "**Model's** with this rule can not be giving **run order**", "hidden": false},
      {"name": "Command Vehicle", "id": "32ca-def0-81a0-34e8", "description": "Adds morale bonus of +1 to itself and friendly vehicles within 12” ", "hidden": false}
